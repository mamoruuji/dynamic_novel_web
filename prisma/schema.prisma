model TypeColor {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  frame Section[] @relation("frameColor")
  text  Section[] @relation("textColor")

  @@map(name: "type_colors")
}

model TypeFont {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  sections Section[]

  @@map(name: "type_fonts")
}

model TypeImage {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  image Image[]

  @@map(name: "type_images")
}

model TypePosition {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  sections Section[]

  @@map(name: "type_positions")
}

model TypeSection {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  sections Section[]

  @@map(name: "type_sections")
}

model TypeSize {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  sections Section[]

  @@map(name: "type_sizes")
}

model TypeSort {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  @@map(name: "type_sorts")
}
