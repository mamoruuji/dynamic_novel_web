// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  theme    = "forest"
  mmdcPath = "node_modules/.bin"
  output   = "scheme.md"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String    @db.VarChar(30)
  email         String    @unique @db.VarChar(319)
  emailVerified DateTime?
  penName       String    @unique @default("無名") @map(name: "pen_name") @db.VarChar(255)
  text          String    @default("") @db.VarChar(500)
  imageUrl      String    @default("no_image") @map(name: "image_url")
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map(name: "updated_at")

  dynamics      Dynamic[]
  following     Follow[]      @relation("followingRelation")
  followers     Follow[]      @relation("followerRelation")
  impressions   Impression[]
  viewHistories ViewHistory[]
  folders       Folder[]
  images        Image[]
  accounts      Account[]
  sessions      Session[]

  @@map(name: "users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map(name: "accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now()) @map(name: "created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map(name: "sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map(name: "verificationTokens")
}

model Dynamic {
  id        Int      @id @default(autoincrement())
  name      String   @unique @default("新しい作品") @db.VarChar(255)
  overview  String   @db.VarChar(500)
  published Boolean  @default(false)
  userId    String   @map(name: "user_id")
  imageUrl  String   @default("no_image") @map(name: "image_url")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  user          User             @relation(fields: [userId], references: [id])
  chapters      Chapter[]
  impressions   Impression[]
  viewHistories ViewHistory[]
  terms         Term[]
  tags          DynamicsOnTags[]

  @@map(name: "dynamics")
}

model Chapter {
  id        Int      @id @default(autoincrement())
  name      String   @default("新しい章") @db.VarChar(255)
  order     Int
  dynamicId Int      @map(name: "dynamic_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  dynamic Dynamic @relation(fields: [dynamicId], references: [id])
  pages   Page[]
  terms   Term[]

  @@map(name: "chapters")
}

model Page {
  id        Int      @id @default(autoincrement())
  name      String   @default("新しいページ") @db.VarChar(255)
  order     Int
  chapterId Int      @map(name: "chapter_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  chapter       Chapter       @relation(fields: [chapterId], references: [id])
  sections      Section[]
  viewHistories ViewHistory[]
  terms         Term[]

  @@map(name: "pages")
}

model Section {
  id              Int      @id @default(autoincrement())
  name            String   @default("新しいセクション") @db.VarChar(255)
  order           Int
  typeSectionId   Int      @default(1) @map(name: "type_section_id")
  typeBubbleId    Int      @default(1) @map(name: "type_bubble_id")
  typePositionId  Int      @default(1) @map(name: "type_position_id")
  typeAnimationId Int      @default(1) @map(name: "type_animation_id")
  imageUrl        String   @default("no_image") @map(name: "image_url")
  frameColorId    Int      @default(1) @map(name: "frame_color_id")
  typeFontId      Int      @default(3) @map(name: "type_font_id")
  text            String   @default("")
  textColorId     Int      @default(1) @map(name: "text_color_id")
  textSizeId      Int      @default(1) @map(name: "text_size_id")
  pageId          Int      @map(name: "page_id")
  createdAt       DateTime @default(now()) @map(name: "created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map(name: "updated_at")

  page       Page          @relation(fields: [pageId], references: [id])
  type       TypeSection   @relation(fields: [typeSectionId], references: [id])
  // bubble     TypeBubble    @relation(fields: [typeBubbleId], references: [id])
  position   TypePosition  @relation(fields: [typePositionId], references: [id])
  animation  TypeAnimation @relation(fields: [typeAnimationId], references: [id])
  font       TypeFont      @relation(fields: [typeFontId], references: [id])
  textSize   TypeSize      @relation(fields: [textSizeId], references: [id])
  frameColor TypeColor     @relation("frameColor", fields: [frameColorId], references: [id])
  textColor  TypeColor     @relation("textColor", fields: [textColorId], references: [id])
  term       Term[]

  @@map(name: "sections")
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String   @default("新しいフォルダ") @db.VarChar(255)
  userId    String   @map(name: "user_id")
  parentId  Int?     @map(name: "parent_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  user     User     @relation(fields: [userId], references: [id])
  parent   Folder?  @relation("ParentChilds", fields: [parentId], references: [id])
  children Folder[] @relation("ParentChilds")
  images   Image[]

  @@unique([name, parentId])
  @@map(name: "folders")
}

model Image {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  path      String   @db.VarChar(2048)
  userId    String   @map(name: "user_id")
  typeId    Int      @default(1) @map(name: "type_Image_id")
  folderId  Int?     @map(name: "folder_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  user   User      @relation(fields: [userId], references: [id])
  type   TypeImage @relation(fields: [typeId], references: [id])
  folder Folder?   @relation(fields: [folderId], references: [id])

  @@unique([name, folderId])
  @@map(name: "images")
}

model Term {
  id        Int      @id @default(autoincrement())
  name      String   @default("新しい用語") @db.VarChar(255)
  text      String   @db.VarChar(200)
  order     Int
  dynamicId Int?     @map(name: "dynamic_id")
  chapterId Int?     @map(name: "chapter_id")
  pageId    Int?     @map(name: "page_id")
  sectionId Int?     @map(name: "section_id")
  imageUrl  String   @default("no_image") @map(name: "image_url")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  dynamic Dynamic? @relation(fields: [dynamicId], references: [id])
  chapter Chapter? @relation(fields: [chapterId], references: [id])
  page    Page?    @relation(fields: [pageId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@map(name: "terms")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  dynamics DynamicsOnTags[]

  @@map(name: "tags")
}

model DynamicsOnTags {
  id        Int      @id @default(autoincrement())
  dynamicId Int      @map(name: "dynamic_id")
  tagId     Int      @map(name: "tag_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  dynamic Dynamic @relation(fields: [dynamicId], references: [id])
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@unique([dynamicId, tagId])
  @@map(name: "dynamics_on_tags")
}

model Follow {
  id         Int      @id @default(autoincrement())
  followerId String   @map(name: "follower_id")
  followeeId String   @map(name: "followee_id")
  createdAt  DateTime @default(now()) @map(name: "created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map(name: "updated_at")

  follower User @relation("followingRelation", fields: [followerId], references: [id])
  followee User @relation("followerRelation", fields: [followeeId], references: [id])

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
  @@map(name: "follows")
}

model Impression {
  id        Int      @id @default(autoincrement())
  rate      Int      @default(1)
  name      String   @db.VarChar(30)
  text      String   @db.VarChar(500)
  published Boolean  @default(false)
  userId    String   @map(name: "user_id")
  dynamicId Int      @map(name: "dynamic_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  user    User    @relation(fields: [userId], references: [id])
  dynamic Dynamic @relation(fields: [dynamicId], references: [id])

  @@unique([userId, dynamicId])
  @@map(name: "impressions")
}

model ViewHistory {
  id        Int      @id @default(autoincrement())
  userId    String   @map(name: "user_id")
  dynamicId Int      @map(name: "dynamic_id")
  pageId    Int      @map(name: "page_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dynamic Dynamic @relation(fields: [dynamicId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, dynamicId])
  @@index([userId, createdAt])
  @@map(name: "view_histories")
}

model TypeAnimation {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  value     String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @updatedAt @map(name: "updated_at")

  sections Section[]

  @@map(name: "type_animations")
}

